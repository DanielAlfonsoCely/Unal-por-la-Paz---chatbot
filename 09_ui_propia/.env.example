# Copia este archivo como .env.local y completa los valores.

# URL de la API de Dify (termina en /v1)
#   Desde la laptop (Tailscale):           http://100.103.228.104/v1
#   En el Nodo 10, fuera de Docker:        http://localhost/v1
#   En el Nodo 10, dentro del contenedor:  http://host.docker.internal/v1
DIFY_API_URL=http://100.103.228.104/v1

# API key de la app (Dify > app > "Acceso a la API" > API Key). Empieza por "app-".
# Nunca llega al navegador: solo la usan las rutas /api del servidor.
DIFY_APP_KEY=

# true = no llama a Dify; simula respuestas para probar la interfaz.
DEMO_MODE=true
